1 ICON "assets\\unrar.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "UnRAR contributors"
            VALUE "FileDescription",  "UnRAR archiver"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "UnRAR"
            VALUE "LegalCopyright",   "MIT License - UnRAR contributors"
            VALUE "OriginalFilename", "UnRAR.exe"
            VALUE "ProductName",      "UnRAR"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
